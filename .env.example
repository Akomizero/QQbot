# Generate a fresh random token (32+ allowed ASCII characters).
ONEBOT_ACCESS_TOKEN=
QQBOT_ONEBOT_PORT=16700
QQBOT_ONEBOT_PATH=/onebot/v11/ws
QQBOT_WEB_PORT=3000
# Model endpoint and model ID are configured in the authenticated management page.
QQBOT_LLM_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
